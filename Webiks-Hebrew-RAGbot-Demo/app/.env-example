# Update environment variables
# Rename this file to .env


# Server
HOST=localhost
PORT=5000


# Versions
CODE_VERSION=1.1.0
MODELS_VERSION=0.0.1


# ElasticSearch
DOCKER_ES_SCHEME=http
DOCKER_ES_HOST=localhost
DOCKER_ES_PORT=9200
ES_EMBEDDING_INDEX=
ES_EMBEDDING_INDEX_LENGTH=1000
PATH_TO_ES_INITIAL_VALUES=../../Webiks_Hebrew_RAGbot_KolZchut_Paragraphs_Corpus_v1.0.json


# Indexes
CONVERSATION_INDEX=conversation
CONFIG_INDEX=saved_configurations
CONFIG_CACHE_PERIOD_SECS=3


# Paths
STATIC_DIR=../../app/src/static
MODEL_LOCATION=../../app/artifacts
DOCUMENT_DEFINITION_CONFIG=./doc-config.json


# LLM
OAI_API_KEY=
IS_MOCK_GPT_CLIENT=FALSE


# Reranker (optional, off by default). Turn on to re-order search results with a
# more careful model before picking pages. RERANK_MODEL can be a Hugging Face id
# or a local folder (use a local path to run fully offline). RERANK_TOP is how
# many top results it re-reads per query (fewer = faster on a CPU).
RERANK_ENABLED=FALSE
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP=20
RERANK_MAX_SEQ=512
# How to use the reranker's opinion: "blend" merges it with the search order
# (both opinions count; measured best), "replace" uses the reranker order alone.
RERANK_MODE=blend
RERANK_BLEND_K=5


# Page scoring -- THE submitted improvement. Off by default so the original
# behaviour is untouched; set PAGE_SCORING_ENABLED=TRUE to turn it on. Ranks
# each page by its best paragraph PLUS a title match and its second-best
# paragraph, all from the same retrieval model. Only the order of the retrieved
# candidates changes. The weights below were chosen on 250 development
# questions and confirmed on 250 held-out questions (see SUBMISSION.md).
# PAGE_SCORING_MARGIN: only pages within this much of the top paragraph score
# can move up (guards against generic "hub" pages); set to "none" to disable.
PAGE_SCORING_ENABLED=FALSE
PAGE_SCORING_TITLE_WEIGHT=0.25
PAGE_SCORING_SECOND_WEIGHT=0.25
PAGE_SCORING_MARGIN=0.05
